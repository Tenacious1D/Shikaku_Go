.banner-dock-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.banner-dock-surface {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 150px;
    background-color: rgb(244, 238, 220);
    border-top-width: 5px;
    border-top-color: rgb(218, 212, 194);
}

.banner-dock-remove-ads-button {
    position: absolute;
    right: 34px;
    bottom: 150px;
    width: 92px;
    height: 92px;
    margin: 0;
    padding: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgb(244, 238, 220);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 0;
    border-left-width: 5px;
    border-color: rgb(218, 212, 194);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.banner-dock-remove-ads-button:active {
    translate: 0 4px;
}

.banner-dock-remove-ads-button:disabled {
    opacity: 0.52;
}

.banner-dock-remove-ads-icon {
    width: 60px;
    height: 60px;
    position: relative;
}

.banner-dock-remove-ads-stroke {
    position: absolute;
    left: 4px;
    top: 24px;
    width: 52px;
    height: 11px;
    background-color: rgb(230, 58, 64);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.banner-dock-remove-ads-stroke-forward {
    rotate: 45deg;
}

.banner-dock-remove-ads-stroke-back {
    rotate: -45deg;
}

.theme-dark .banner-dock-surface,
.theme-dark .banner-dock-remove-ads-button {
    background-color: rgb(34, 32, 29);
    border-color: rgb(64, 60, 54);
}

.screen-hidden {
    display: none;
}
