.adventure-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
}

.adventure-view {
    flex-grow: 1;
    width: 100%;
    max-width: 920px;
    min-height: 100%;
    padding-top: 88px;
    padding-right: 38px;
    padding-bottom: 32px;
    padding-left: 38px;
    align-items: center;
}

.adventure-back-button {
    position: absolute;
    left: 38px;
    top: 63px;
    width: 104px;
    height: 108px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(241, 237, 221);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 8px;
    border-left-width: 3px;
    border-color: rgb(190, 182, 161);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.adventure-back-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.adventure-back-icon {
    width: 66px;
    height: 66px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.adventure-title-block,
.adventure-level-header {
    flex-shrink: 0;
    width: 100%;
    height: 230px;
    align-items: center;
    justify-content: flex-end;
}

.adventure-title {
    margin: 0;
    padding: 0;
    color: rgb(177, 52, 55);
    font-size: 103px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: rgb(247, 226, 217);
}

.adventure-title-ornament {
    width: 470px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.adventure-ornament-line {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(145, 134, 113, 0.45);
}

.adventure-ornament-icon {
    width: 44px;
    height: 44px;
    margin-right: 25px;
    margin-left: 25px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_adventure.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(177, 52, 55);
}

.adventure-subtitle {
    flex-shrink: 0;
    margin: 2px 0 11px 0;
    padding: 0;
    color: rgb(72, 62, 48);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.adventure-progress-chip {
    flex-shrink: 0;
    min-width: 460px;
    height: 74px;
    margin-bottom: 14px;
    padding-right: 30px;
    padding-left: 30px;
    align-items: center;
    justify-content: center;
    background-color: rgba(245, 239, 220, 0.94);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-color: rgb(205, 195, 171);
    border-top-left-radius: 37px;
    border-top-right-radius: 37px;
    border-bottom-right-radius: 37px;
    border-bottom-left-radius: 37px;
}

.adventure-progress-label {
    margin: 0;
    padding: 0;
    color: rgb(117, 74, 55);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.adventure-scroll-view {
    flex-grow: 1;
    width: 100%;
    min-height: 0;
}

.adventure-scroll-view > .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.adventure-scroll-view .unity-scroller {
    display: none;
}

.adventure-map-content,
.adventure-level-scroll-content {
    width: 100%;
    align-items: center;
    padding-top: 18px;
    padding-bottom: 70px;
}

.adventure-map-root {
    width: 100%;
    max-width: 790px;
    align-items: center;
}

.adventure-map-row {
    flex-shrink: 0;
    width: 100%;
    height: 142px;
    flex-direction: row;
    align-items: center;
}

.adventure-map-row-left {
    justify-content: flex-start;
    padding-left: 30px;
}

.adventure-map-row-right {
    justify-content: flex-end;
    padding-right: 30px;
}

.adventure-chapter-button {
    width: 440px;
    height: 128px;
    margin: 0;
    padding: 12px 18px 14px 15px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(247, 241, 222);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 9px;
    border-left-width: 3px;
    border-color: rgb(191, 179, 152);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.adventure-chapter-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.adventure-chapter-denied {
    translate: -9px 0;
}

.adventure-chapter-badge {
    flex-shrink: 0;
    width: 82px;
    height: 82px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
    background-color: rgb(185, 62, 62);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 6px;
    border-left-width: 2px;
    border-color: rgb(126, 42, 43);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
    border-bottom-left-radius: 22px;
}

.adventure-chapter-number {
    margin: 0;
    padding: 0;
    color: rgb(255, 247, 226);
    font-size: 39px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(75, 38, 31, 0.45);
}

.adventure-chapter-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.adventure-chapter-title {
    margin: 0;
    padding: 0;
    color: rgb(61, 49, 37);
    font-size: 34px;
    -unity-font-style: bold;
}

.adventure-chapter-progress {
    margin: 2px 0 0 0;
    padding: 0;
    color: rgb(105, 91, 70);
    font-size: 21px;
    -unity-font-style: bold;
}

.adventure-chapter-state {
    flex-shrink: 0;
    width: 43px;
    margin: 0;
    padding: 0;
    color: rgb(117, 68, 51);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.adventure-chapter-current {
    background-color: rgb(252, 238, 202);
    border-color: rgb(215, 151, 37);
}

.adventure-chapter-current .adventure-chapter-badge {
    background-color: rgb(210, 143, 28);
    border-color: rgb(151, 96, 20);
}

.adventure-chapter-current .adventure-chapter-state {
    color: rgb(177, 112, 20);
}

.adventure-chapter-complete {
    background-color: rgb(230, 241, 213);
    border-color: rgb(73, 139, 72);
}

.adventure-chapter-complete .adventure-chapter-badge {
    background-color: rgb(54, 140, 67);
    border-color: rgb(34, 96, 45);
}

.adventure-chapter-complete .adventure-chapter-state {
    color: rgb(45, 130, 58);
}

.adventure-chapter-locked {
    background-color: rgba(211, 204, 186, 0.76);
    border-color: rgba(174, 164, 143, 0.74);
}

.adventure-chapter-locked .adventure-chapter-badge {
    background-color: rgb(137, 132, 120);
    border-color: rgb(104, 98, 87);
}

.adventure-chapter-locked .adventure-chapter-title,
.adventure-chapter-locked .adventure-chapter-progress,
.adventure-chapter-locked .adventure-chapter-state {
    color: rgba(90, 84, 74, 0.68);
}

.adventure-route-connector {
    flex-shrink: 0;
    position: relative;
    width: 100%;
    height: 126px;
}

.adventure-route-dash {
    position: absolute;
    width: 22px;
    height: 6px;
    margin-left: -11px;
    margin-top: -3px;
    background-color: rgba(101, 87, 66, 0.30);
    border-width: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.adventure-route-dash-active {
    background-color: rgba(86, 70, 49, 0.72);
}

/* Adventure chapter level selector */

.adventure-level-title {
    margin: 0;
    padding: 0;
    color: rgb(181, 53, 56);
    font-size: 104px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: rgb(247, 226, 217);
}

.adventure-level-progress-chip {
    margin-bottom: 14px;
}

.adventure-continue-button {
    flex-shrink: 0;
    width: 100%;
    max-width: 610px;
    height: 104px;
    margin: 0 0 22px 0;
    padding-right: 24px;
    padding-left: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(181, 53, 56);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 9px;
    border-left-width: 3px;
    border-color: rgb(121, 37, 40);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
    border-bottom-left-radius: 22px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.adventure-continue-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.adventure-continue-icon {
    flex-shrink: 0;
    width: 62px;
    height: 62px;
    margin-right: 22px;
    align-items: center;
    justify-content: center;
    background-color: rgb(247, 242, 224);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-width: 2px;
    border-color: rgb(123, 38, 40);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.adventure-continue-icon-label {
    width: 28px;
    height: 32px;
    margin-left: 3px;
    -unity-background-image-tint-color: rgb(174, 49, 53);
}

.adventure-chapter-state-play {
    height: 36px;
    -unity-background-image-tint-color: rgb(177, 112, 20);
}

.adventure-continue-label {
    margin: 0;
    padding: 0;
    color: rgb(255, 250, 234);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.38);
}

.adventure-level-grid {
    width: 100%;
    max-width: 780px;
}

.adventure-level-grid-panel {
    width: 100%;
    margin-bottom: 34px;
    padding-top: 18px;
    padding-right: 14px;
    padding-bottom: 20px;
    padding-left: 14px;
    background-color: rgba(241, 235, 215, 0.88);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-color: rgba(192, 183, 161, 0.82);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
    border-bottom-left-radius: 22px;
}

.adventure-level-row {
    width: 100%;
    height: 132px;
    flex-direction: row;
}

.adventure-level-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 5px;
}

.adventure-level-blank {
    background-color: rgba(0, 0, 0, 0);
}

.adventure-level-button {
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(248, 242, 223);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-color: rgb(195, 184, 160);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-duration: 0.07s;
    transition-property: translate;
}

.adventure-level-button:active {
    translate: 0 4px;
    border-bottom-width: 3px;
}

.adventure-level-number {
    margin: 0;
    padding: 0;
    color: rgb(63, 52, 39);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.adventure-level-next {
    background-color: rgb(252, 238, 202);
    border-color: rgb(213, 151, 37);
}

.adventure-level-next .adventure-level-number {
    color: rgb(165, 55, 54);
}

.adventure-level-next-label,
.adventure-level-locked-label {
    position: absolute;
    bottom: 7px;
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.adventure-level-next-label {
    color: rgb(165, 55, 54);
}

.adventure-level-completed {
    border-color: rgb(71, 139, 70);
}

.adventure-level-checkmark {
    position: absolute;
    right: 8px;
    top: 5px;
    margin: 0;
    padding: 0;
    color: rgb(43, 128, 55);
    font-size: 25px;
    -unity-font-style: bold;
}

.adventure-level-locked {
    background-color: rgba(211, 204, 186, 0.72);
    border-color: rgba(174, 164, 143, 0.72);
}

.adventure-level-locked .adventure-level-number,
.adventure-level-locked-label {
    color: rgba(92, 84, 71, 0.56);
}
/* The existing chapter controls remain below the shared building renderer. */
.adventure-map-row { height: 378px; }
.adventure-chapter-button { height: 364px; flex-direction: column; }
.adventure-building-view { width: 100%; height: 220px; flex-shrink: 0; }
.adventure-chapter-details {
    width: 100%;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

/* Adventure city map. Light is the default; ThemeManager switches the ancestor class.
   Custom colors also drive the retained street drawing when the theme changes. */
#adventure-map-view {
    max-width: none;
    padding: 30px 14px 0 14px;
    background-color: rgb(232, 235, 220);
}
#adventure-map-view .adventure-title-block { height: 128px; justify-content: center; }
#adventure-map-view .adventure-title { font-size: 67px; color: rgb(43, 66, 63); -unity-text-outline-width: 0; }
#adventure-map-view .adventure-title-ornament { display: none; }
#adventure-map-view .adventure-subtitle { font-size: 25px; color: rgb(81, 105, 98); margin: 0 0 15px 0; }
#adventure-map-view .adventure-progress-chip {
    min-width: 0; height: 47px; margin-bottom: 16px; padding: 0 25px;
    background-color: rgb(218, 228, 207); border-width: 1px; border-color: rgb(153, 175, 151); border-radius: 24px;
}
#adventure-map-view .adventure-progress-label { font-size: 22px; color: rgb(59, 86, 64); }
#adventure-map-view .adventure-map-content { padding: 0; }
#adventure-map-root {
    padding: 0; border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0); max-width: none;
}
#adventure-screen > .adventure-back-button { width: 76px; height: 76px; left: 26px; top: 57px; }
#adventure-screen > .adventure-back-button .adventure-back-icon { width: 45px; height: 45px; }
.adventure-city-map {
    background-color: rgb(232, 235, 220); overflow: hidden;
    --city-sidewalk: rgb(193, 198, 180);
    --city-asphalt: rgb(108, 121, 121);
    --city-marking: rgb(241, 231, 191);
    --city-paving: rgb(221, 219, 197);
    --city-lawn: rgb(162, 192, 143);
    --city-leaf: rgb(106, 157, 112);
    --city-night: 0;
}
.city-building-node { align-items: center; }
.city-building-view { flex-shrink: 0; }
.city-chapter-button {
    margin: 0; padding: 0; min-width: 0; min-height: 0;
    align-items: center; justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0;
}
.city-chapter-button:hover, .city-chapter-button:active, .city-chapter-button:focus {
    background-color: rgba(0, 0, 0, 0); border-width: 0;
}
.city-address {
    margin: 0; padding: 0 5px; white-space: nowrap; flex-shrink: 0;
    -unity-text-align: middle-center; -unity-font-style: bold;
    color: rgb(45, 68, 64); background-color: rgb(248, 248, 233);
    border-width: 1px; border-bottom-width: 3px; border-color: rgb(147, 166, 148); border-radius: 20px;
    transition-duration: 0.08s; transition-property: translate;
}
.city-chapter-button:hover .city-address, .city-chapter-button:focus .city-address { border-color: rgb(55, 117, 107); }
.city-chapter-button:active .city-address { translate: 0 2px; }
.city-chapter-current .city-address { color: rgb(96, 66, 20); background-color: rgb(252, 232, 173); border-color: rgb(190, 142, 43); }
.city-chapter-complete .city-address { color: rgb(41, 88, 61); background-color: rgb(218, 237, 215); border-color: rgb(119, 165, 125); }
.city-chapter-locked .city-address { color: rgb(111, 120, 112); background-color: rgb(219, 224, 211); border-color: rgb(168, 178, 163); }
.city-chapter-button.adventure-chapter-denied .city-address { translate: -7px 0; }

.theme-dark #adventure-map-view { background-color: rgb(22, 43, 55); }
.theme-dark #adventure-map-view .adventure-title { color: rgb(240, 230, 203); }
.theme-dark #adventure-map-view .adventure-subtitle { color: rgb(162, 196, 194); }
.theme-dark #adventure-map-view .adventure-progress-chip { background-color: rgb(34, 65, 72); border-color: rgb(72, 115, 115); }
.theme-dark #adventure-map-view .adventure-progress-label { color: rgb(225, 216, 183); }
.theme-dark .adventure-city-map {
    background-color: rgb(22, 43, 55);
    --city-sidewalk: rgb(65, 88, 93);
    --city-asphalt: rgb(35, 54, 64);
    --city-marking: rgb(173, 160, 117);
    --city-paving: rgb(37, 62, 68);
    --city-lawn: rgb(41, 79, 67);
    --city-leaf: rgb(66, 116, 86);
    --city-night: 1;
}
.theme-dark .city-address { color: rgb(219, 232, 224); background-color: rgb(37, 66, 78); border-color: rgb(93, 130, 135); }
.theme-dark .city-chapter-button:hover .city-address, .theme-dark .city-chapter-button:focus .city-address { border-color: rgb(177, 216, 190); }
.theme-dark .city-chapter-current .city-address { color: rgb(255, 232, 167); background-color: rgb(86, 72, 41); border-color: rgb(225, 180, 72); }
.theme-dark .city-chapter-complete .city-address { color: rgb(203, 236, 207); background-color: rgb(34, 68, 60); border-color: rgb(106, 164, 127); }
.theme-dark .city-chapter-locked .city-address { color: rgb(154, 177, 183); background-color: rgb(32, 51, 63); border-color: rgb(64, 90, 106); }