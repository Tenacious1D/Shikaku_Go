.free-play-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
}

.free-play-view {
    flex-grow: 1;
    width: 100%;
    max-width: 920px;
    min-height: 100%;
    padding-top: 88px;
    padding-right: 38px;
    padding-bottom: 32px;
    padding-left: 38px;
    align-items: center;
}

.free-play-back-button {
    position: absolute;
    left: 38px;
    top: 63px;
    width: 104px;
    height: 108px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(241, 237, 221);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 8px;
    border-left-width: 3px;
    border-color: rgb(190, 182, 161);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.free-play-back-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.free-play-back-icon {
    width: 66px;
    height: 66px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.free-play-title-block {
    flex-shrink: 0;
    width: 700px;
    height: 255px;
    align-items: center;
    justify-content: center;
}

.free-play-title-row {
    height: 165px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.free-play-title-icon {
    width: 102px;
    height: 102px;
    margin-right: 25px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_free_play.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(48, 126, 62);
}

.free-play-title-dark,
.free-play-title-green {
    margin: 0;
    padding: 0;
    font-size: 103px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 7px;
}

.free-play-title-dark {
    color: rgb(42, 42, 39);
    -unity-text-outline-color: rgb(247, 242, 225);
}

.free-play-title-green {
    margin-left: 20px;
    color: rgb(52, 140, 67);
    -unity-text-outline-color: rgb(220, 240, 219);
}

.free-play-title-ornament {
    width: 470px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.free-play-ornament-line {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(145, 134, 113, 0.45);
}

.free-play-ornament-icon {
    width: 44px;
    height: 44px;
    margin-right: 25px;
    margin-left: 25px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_free_play.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(52, 140, 67);
}

.free-play-scroll-view {
    flex-grow: 1;
    width: 100%;
    min-height: 0;
}

.free-play-scroll-view > .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.free-play-scroll-view .unity-scroller {
    display: none;
}

.free-play-size-scroll-content,
.free-play-level-scroll-content {
    width: 100%;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 42px;
}

.free-play-category {
    flex-shrink: 0;
    width: 100%;
    max-width: 780px;
    margin-bottom: 26px;
    padding-top: 13px;
    padding-right: 17px;
    padding-bottom: 16px;
    padding-left: 17px;
    background-color: rgba(241, 235, 215, 0.96);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 9px;
    border-left-width: 3px;
    border-color: rgb(192, 183, 161);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-right-radius: 23px;
    border-bottom-left-radius: 23px;
}

.free-play-category-heading {
    width: 100%;
    height: 57px;
    margin: 0 0 11px 0;
    padding: 0 17px 0 16px;
    flex-direction: row;
    align-items: center;
    color: rgb(255, 250, 234);
    background-color: rgb(52, 140, 67);
    border-width: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.35);
}

.free-play-category-easy .free-play-category-heading {
    background-color: rgb(83, 150, 76);
}

.free-play-category-medium .free-play-category-heading {
    background-color: rgb(42, 111, 176);
}

.free-play-category-hard .free-play-category-heading {
    background-color: rgb(190, 61, 57);
}

.free-play-category-heading-text {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    color: rgb(255, 250, 234);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.35);
}

.free-play-size-row {
    width: 100%;
    flex-direction: column;
}

.free-play-size-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 126px;
    margin: 0 0 11px 0;
    padding: 0;
    background-color: rgba(249, 244, 227, 0.96);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-color: rgb(197, 187, 164);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.free-play-size-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.free-play-size-button:disabled {
    opacity: 0.48;
}

.free-play-size-inner {
    flex-grow: 1;
    margin: 6px;
    padding-right: 18px;
    padding-left: 13px;
    flex-direction: row;
    align-items: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: rgba(255, 255, 255, 0.72);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
}

.free-play-size-badge {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    margin-right: 24px;
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 140, 67);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 6px;
    border-left-width: 2px;
    border-color: rgb(35, 98, 47);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
}

.free-play-easy .free-play-size-badge {
    background-color: rgb(83, 150, 76);
    border-color: rgb(52, 104, 48);
}

.free-play-medium .free-play-size-badge {
    background-color: rgb(42, 111, 176);
    border-color: rgb(28, 78, 128);
}

.free-play-hard .free-play-size-badge {
    background-color: rgb(190, 61, 57);
    border-color: rgb(131, 39, 39);
}

.free-play-size-label {
    margin: 0;
    padding: 0;
    color: rgb(255, 250, 234);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.4);
}

.free-play-size-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.free-play-size-progress {
    margin: 0;
    padding: 0;
    color: rgb(78, 66, 50);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.free-play-size-arrow {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 0;
    color: rgb(81, 72, 59);
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.free-play-level-header {
    flex-shrink: 0;
    width: 100%;
    height: 255px;
    align-items: center;
    justify-content: flex-end;
}

.free-play-level-title {
    margin: 0;
    padding: 0;
    color: rgb(52, 140, 67);
    font-size: 116px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: rgb(220, 240, 219);
}

.free-play-level-subtitle {
    margin: -9px 0 8px 0;
    padding: 0;
    color: rgb(72, 62, 48);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-level-progress-chip {
    flex-shrink: 0;
    min-width: 370px;
    height: 82px;
    margin-bottom: 14px;
    padding-right: 32px;
    padding-left: 32px;
    align-items: center;
    justify-content: center;
    background-color: rgba(245, 239, 220, 0.94);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-width: 3px;
    border-color: rgb(205, 195, 171);
    border-top-left-radius: 41px;
    border-top-right-radius: 41px;
    border-bottom-right-radius: 41px;
    border-bottom-left-radius: 41px;
}

.free-play-level-progress {
    margin: 0;
    padding: 0;
    color: rgb(66, 112, 61);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-continue-button {
    flex-shrink: 0;
    width: 100%;
    max-width: 610px;
    height: 104px;
    margin: 0 0 22px 0;
    padding-right: 24px;
    padding-left: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(52, 140, 67);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 9px;
    border-left-width: 3px;
    border-color: rgb(34, 98, 47);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
    border-bottom-left-radius: 22px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.free-play-continue-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.free-play-continue-icon {
    flex-shrink: 0;
    width: 62px;
    height: 62px;
    margin-right: 22px;
    align-items: center;
    justify-content: center;
    background-color: rgb(247, 242, 224);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-width: 2px;
    border-color: rgb(38, 104, 49);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.free-play-continue-icon-label {
    width: 28px;
    height: 32px;
    margin-left: 3px;
    -unity-background-image-tint-color: rgb(44, 126, 58);
}

.free-play-continue-label {
    margin: 0;
    padding: 0;
    color: rgb(255, 250, 234);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.38);
}
.free-play-level-grid {
    width: 100%;
    max-width: 780px;
}

.free-play-level-grid-panel {
    width: 100%;
    margin-bottom: 34px;
    padding-top: 18px;
    padding-right: 14px;
    padding-bottom: 20px;
    padding-left: 14px;
    background-color: rgba(241, 235, 215, 0.88);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-color: rgba(192, 183, 161, 0.82);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
    border-bottom-left-radius: 22px;
}
.free-play-level-row {
    width: 100%;
    height: 132px;
    flex-direction: row;
}

.free-play-level-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 5px;
}

.free-play-level-blank {
    background-color: rgba(0, 0, 0, 0);
}

.free-play-level-button {
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(248, 242, 223);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-color: rgb(195, 184, 160);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-duration: 0.07s;
    transition-property: translate;
}

.free-play-level-button:active {
    translate: 0 4px;
    border-bottom-width: 3px;
}

.free-play-level-number {
    margin: 0;
    padding: 0;
    color: rgb(63, 52, 39);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-level-next {
    background-color: rgb(238, 243, 211);
    border-color: rgb(219, 160, 40);
}

.free-play-level-next .free-play-level-number {
    color: rgb(49, 119, 58);
}

.free-play-level-next-label {
    position: absolute;
    bottom: 7px;
    margin: 0;
    padding: 0;
    color: rgb(45, 126, 57);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.free-play-level-completed {
    border-color: rgb(71, 139, 70);
}

.free-play-level-checkmark {
    position: absolute;
    right: 8px;
    top: 5px;
    margin: 0;
    padding: 0;
    color: rgb(43, 128, 55);
    font-size: 25px;
    -unity-font-style: bold;
}

.free-play-level-locked {
    background-color: rgba(211, 204, 186, 0.72);
    border-color: rgba(174, 164, 143, 0.72);
}

.free-play-level-locked .free-play-level-number {
    color: rgba(97, 91, 80, 0.56);
}

.free-play-level-locked-label {
    position: absolute;
    bottom: 8px;
    margin: 0;
    padding: 0;
    color: rgba(92, 84, 71, 0.58);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
/* Pack-first Free Play navigation */
.free-play-pack-scroll {
    margin-top: 8px;
}

.free-play-pack-list,
.free-play-size-list {
    width: 100%;
    max-width: 780px;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 42px;
}

.free-play-pack-button {
    flex-shrink: 0;
    width: 100%;
    height: 154px;
    margin: 0 0 24px 0;
    padding: 12px 20px 17px 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(247, 241, 222, 0.97);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 9px;
    border-left-width: 3px;
    border-color: rgb(190, 181, 158);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-right-radius: 23px;
    border-bottom-left-radius: 23px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.free-play-pack-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.free-play-pack-emblem {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    margin-right: 26px;
    padding: 0;
    align-items: center;
    justify-content: center;
    color: rgb(255, 250, 234);
    background-color: rgb(52, 140, 67);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 8px;
    border-left-width: 3px;
    border-color: rgb(34, 98, 47);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
}

.free-play-pack-emblem-label {
    font-size: 35px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(40, 33, 25, 0.38);
}

.free-play-pack-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.free-play-pack-name {
    margin: 0 0 6px 0;
    padding: 0;
    color: rgb(54, 47, 38);
    font-size: 37px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.free-play-pack-progress {
    margin: 0;
    padding: 0;
    color: rgb(105, 91, 70);
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.free-play-pack-number {
    flex-shrink: 0;
    margin: 0 18px 0 12px;
    padding: 0;
    color: rgba(115, 103, 82, 0.5);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-pack-arrow {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: rgb(80, 70, 56);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-context-header {
    flex-shrink: 0;
    width: 700px;
    height: 255px;
    align-items: center;
    justify-content: flex-end;
}

.free-play-context-title {
    margin: 0 0 4px 0;
    padding: 0;
    color: rgb(48, 126, 62);
    font-size: 85px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(220, 240, 219);
}

.free-play-subtitle {
    flex-shrink: 0;
    margin: 0 0 22px 0;
    padding: 0;
    color: rgb(84, 73, 58);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-size-list {
    padding-top: 5px;
}

.free-play-size-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 116px;
    margin: 0 0 15px 0;
    padding: 8px 20px 13px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(249, 244, 227, 0.97);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-width: 2px;
    border-color: rgb(197, 187, 164);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-right-radius: 17px;
    border-bottom-left-radius: 17px;
}

.free-play-size-badge {
    flex-shrink: 0;
    width: 92px;
    height: 82px;
    margin: 0 25px 0 0;
    padding: 0;
    color: rgb(255, 250, 234);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 6px;
    border-left-width: 2px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.4);
}

.free-play-size-green .free-play-size-badge {
    background-color: rgb(52, 140, 67);
    border-color: rgb(35, 98, 47);
}

.free-play-size-blue .free-play-size-badge {
    background-color: rgb(42, 111, 176);
    border-color: rgb(28, 78, 128);
}

.free-play-size-red .free-play-size-badge {
    background-color: rgb(190, 61, 57);
    border-color: rgb(131, 39, 39);
}

.free-play-size-progress {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    color: rgb(78, 66, 50);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.free-play-size-arrow {
    flex-shrink: 0;
    margin: 0 0 0 8px;
    padding: 0;
    color: rgb(81, 72, 59);
    font-size: 45px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-level-pack-label {
    margin: -8px 0 5px 0;
    padding: 0;
    color: rgb(83, 72, 56);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.free-play-level-blue .free-play-level-title,
.free-play-level-blue .free-play-level-progress {
    color: rgb(42, 111, 176);
}

.free-play-level-red .free-play-level-title,
.free-play-level-red .free-play-level-progress {
    color: rgb(190, 61, 57);
}

.free-play-level-blue .free-play-level-title {
    -unity-text-outline-color: rgb(218, 232, 243);
}

.free-play-level-red .free-play-level-title {
    -unity-text-outline-color: rgb(244, 220, 216);
}

.free-play-level-blue .free-play-ornament-icon {
    -unity-background-image-tint-color: rgb(42, 111, 176);
}

.free-play-level-red .free-play-ornament-icon {
    -unity-background-image-tint-color: rgb(190, 61, 57);
}

.free-play-level-blue .free-play-continue-button {
    background-color: rgb(42, 111, 176);
    border-color: rgb(28, 78, 128);
}

.free-play-level-red .free-play-continue-button {
    background-color: rgb(190, 61, 57);
    border-color: rgb(131, 39, 39);
}

.free-play-level-blue .free-play-continue-icon {
    border-color: rgb(28, 78, 128);
}

.free-play-level-red .free-play-continue-icon {
    border-color: rgb(131, 39, 39);
}

.free-play-level-blue .free-play-continue-icon-label {
    color: rgb(42, 111, 176);
}

.free-play-level-red .free-play-continue-icon-label {
    color: rgb(190, 61, 57);
}
