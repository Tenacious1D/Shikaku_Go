.gameplay-root, .gameplay-overlay-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}
.gameplay-background {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
    margin: 0; padding: 0;
    background-color: rgb(244, 238, 220);
    background-image: url("project://database/Assets/Art/UI/Backgrounds/shikaku_warm_stone_paper_seamless.png");
    -unity-background-scale-mode: scale-and-crop;
    border-width: 0;
    border-radius: 0;
}
.gameplay-background:hover, .gameplay-background:active, .gameplay-background:focus {
    background-color: rgb(244, 238, 220);
    border-width: 0;
}
.gameplay-safe-area {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    min-height: 100%;
    align-self: center;
    align-items: center;
    padding: 46px 38px 20px 38px;
}
.gameplay-top-balance-spacer {
    flex-shrink: 0;
    width: 100%;
    height: 0;
}
.gameplay-header {
    flex-shrink: 0;
    width: 100%;
    height: 142px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.gameplay-square-button {
    flex-shrink: 0;
    width: 104px; height: 108px;
    margin: 0; padding: 0;
    align-items: center; justify-content: center;
    background-color: rgb(242, 237, 219);
    border-width: 3px;
    border-bottom-width: 8px;
    border-color: rgb(190, 181, 158);
    border-radius: 18px;
}
.gameplay-square-button:active { translate: 0 4px; border-bottom-width: 4px; }
.gameplay-back-icon, .gameplay-next-icon {
    width: 66px; height: 66px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
}
.gameplay-next-icon { rotate: 180deg; }
.gameplay-title-card {
    flex-grow: 1;
    height: 132px;
    max-width: 710px;
    margin: 0 18px;
    align-items: center;
    justify-content: center;
}
.gameplay-header-action-slot {
    flex-shrink: 0;
    width: 104px; height: 108px;
    align-items: center;
    justify-content: center;
}
.gameplay-title {
    margin: 0; padding: 0;
    color: rgb(45, 43, 38);
    font-size: 58px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(247, 242, 225);
}
.gameplay-subtitle {
    margin-top: -2px; padding: 0;
    color: rgb(208, 137, 20);
    font-size: 31px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gameplay-title-ornament {
    flex-shrink: 0;
    width: 420px; height: 28px;
    margin-bottom: 7px;
    flex-direction: row;
    align-items: center;
}
.gameplay-ornament-line, .gameplay-modal-line {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(145, 134, 113, 0.44);
}
.gameplay-ornament-diamond {
    width: 13px; height: 13px;
    margin: 0 26px;
    rotate: 45deg;
    background-color: rgb(84, 142, 83);
}
.gameplay-status-card {
    flex-shrink: 0;
    width: 100%; max-width: 850px; height: 102px;
    margin-bottom: 14px;
    padding: 9px 18px 13px 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(242, 236, 216, 0.96);
    border-width: 2px;
    border-bottom-width: 7px;
    border-color: rgb(190, 180, 156);
    border-radius: 22px;
}
.gameplay-stat {
    flex-grow: 1; flex-basis: 0; min-width: 0; height: 100%;
    align-items: center; justify-content: center;
}
.gameplay-stat-divider { width: 2px; height: 58px; background-color: rgba(153, 139, 113, 0.4); }
.gameplay-stat-caption {
    margin: 0 0 1px 0; padding: 0;
    color: rgb(125, 112, 92);
    font-size: 18px; letter-spacing: 2px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.gameplay-stat-value {
    margin: 0; padding: 0;
    color: rgb(56, 48, 38);
    font-size: 34px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.gameplay-best-value-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.gameplay-best-hint-icon {
    width: 30px;
    height: 30px;
    margin-left: 6px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_hint.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(63, 62, 57);
}
.gameplay-timer { transition-duration: 0.16s; transition-property: scale, color; }
.gameplay-timer-penalty { color: rgb(190, 52, 54); scale: 1.2 1.2; }
.gameplay-play-cluster {
    flex-shrink: 0;
    width: 100%;
    align-items: center;
}
.gameplay-board-slot {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 360px;
    min-height: 0;
}
.gameplay-actions {
    flex-shrink: 0;
    position: relative;
    width: 100%; height: 194px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
}
.gameplay-ad-status {
    position: absolute;
    left: 50%;
    top: -16px;
    translate: -50% -100%;
    min-width: 360px;
    padding: 12px 22px;
    font-size: 25px;
    color: rgb(75, 70, 60);
    -unity-text-align: middle-center;
    background-color: rgba(246, 241, 220, 0.96);
    border-width: 2px;
    border-color: rgb(187, 178, 151);
    border-radius: 22px;
}
.gameplay-action-button {
    flex-shrink: 0;
    width: 166px; height: 166px;
    overflow: visible;
    margin: 0 26px;
    padding: 30px;
    align-items: center;
    justify-content: center;
    background-color: rgb(239, 235, 219);
    border-width: 3px;
    border-bottom-width: 9px;
    border-color: rgb(188, 181, 161);
    border-radius: 21px;
    transition-duration: 0.08s;
    transition-property: translate, background-color;
    transition-timing-function: ease-out;
}
.gameplay-action-button:active { translate: 0 5px; border-bottom-width: 4px; }
.gameplay-action-button:focus {
    border-top-color: rgb(255, 247, 215);
    border-right-color: rgb(255, 247, 215);
    border-left-color: rgb(255, 247, 215);
}
.gameplay-action-button:disabled, .gameplay-modal-button:disabled { opacity: 0.48; }
.gameplay-hint-button, .gameplay-reset-button {
    background-color: rgb(239, 235, 219);
    border-color: rgb(188, 181, 161);
}
.gameplay-hint-idle-glow {
    scale: 1.055 1.055;
    background-color: rgb(250, 242, 205);
    border-top-color: rgb(255, 209, 75);
    border-right-color: rgb(255, 209, 75);
    border-bottom-color: rgb(207, 137, 18);
    border-left-color: rgb(255, 209, 75);
}
.gameplay-action-icon {
    width: 96px; height: 96px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(63, 62, 57);
}
.gameplay-hint-icon { background-image: url("project://database/Assets/Art/UI/Icons/icon_hint.png"); }
.gameplay-reset-icon { background-image: url("project://database/Assets/Art/UI/Icons/icon_reset.png"); }

.gameplay-hint-badge {
    position: absolute;
    top: -24px;
    width: 58px;
    height: 58px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-bottom-width: 6px;
    border-radius: 29px;
}
.gameplay-hint-count-badge {
    right: -21px;
    color: rgb(252, 247, 231);
    font-size: 29px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(70, 43, 12, 0.55);
    background-color: rgb(216, 145, 28);
    border-color: rgb(158, 99, 17);
}
.gameplay-hint-video-badge {
    left: -21px;
    background-color: rgb(242, 236, 217);
    border-color: rgb(183, 170, 143);
}
.gameplay-hint-video-screen {
    width: 35px;
    height: 27px;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-color: rgb(67, 61, 51);
    border-radius: 6px;
}
.gameplay-hint-video-play {
    width: 13px;
    height: 16px;
    margin-left: 2px;
    -unity-background-image-tint-color: rgb(67, 61, 51);
}
.gameplay-flex-spacer {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 0;
}
.gameplay-ad-spacer { flex-shrink: 0; width: 100%; height: 0; }

.gameplay-not-quite-warning {
    position: absolute;
    width: 82%;
    max-width: 760px;
    min-height: 128px;
    padding: 17px 28px 20px 28px;
    align-items: center;
    justify-content: center;
    background-color: rgba(247, 241, 221, 0.99);
    border-width: 3px;
    border-bottom-width: 8px;
    border-color: rgb(181, 169, 143);
    border-radius: 24px;
}
.gameplay-not-quite-title {
    margin: 0 0 5px 0;
    padding: 0;
    color: rgb(178, 57, 58);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gameplay-not-quite-message {
    margin: 0;
    padding: 0;
    color: rgb(75, 67, 55);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.gameplay-layout-tall .gameplay-top-balance-spacer { height: 48px; }
.gameplay-layout-tall.gameplay-layout-balanced .gameplay-top-balance-spacer {
    flex-grow: 1;
    max-height: 176px;
}
.gameplay-layout-tall.gameplay-layout-balanced .gameplay-flex-spacer {
    flex-grow: 2;
}

.gameplay-layout-tall .gameplay-header {
    padding-left: 18px;
    padding-right: 18px;
}
.gameplay-layout-tall .gameplay-status-card {
    margin-top: 32px;
    margin-bottom: 48px;
}
.gameplay-layout-tall .gameplay-actions { margin-top: 32px; }

.gameplay-layout-compact .gameplay-header { height: 122px; }
.gameplay-layout-compact .gameplay-title-card { height: 116px; }
.gameplay-layout-compact .gameplay-square-button,
.gameplay-layout-compact .gameplay-header-action-slot {
    width: 94px;
    height: 98px;
}
.gameplay-layout-compact .gameplay-back-icon,
.gameplay-layout-compact .gameplay-next-icon { width: 58px; height: 58px; }
.gameplay-layout-compact .gameplay-title { font-size: 53px; }
.gameplay-layout-compact .gameplay-subtitle { font-size: 28px; }
.gameplay-layout-compact .gameplay-status-card { height: 92px; }
.gameplay-layout-compact .gameplay-actions { height: 168px; }
.gameplay-layout-compact .gameplay-action-button {
    width: 146px;
    height: 146px;
    margin-left: 22px;
    margin-right: 22px;
    padding: 26px;
}
.gameplay-layout-compact .gameplay-action-icon { width: 84px; height: 84px; }
.gameplay-tutorial-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
    align-items: center;
    justify-content: flex-start;
}
.gameplay-tutorial-shade {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(43, 36, 27, 0.16);
}
.gameplay-tutorial-card-row {
    position: absolute;
    width: 94%;
    max-width: 960px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.gameplay-tutorial-card {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    max-width: 820px;
    min-height: 250px;
    padding: 24px 30px 21px 30px;
    background-color: rgba(247, 241, 221, 0.99);
    border-width: 3px;
    border-bottom-width: 10px;
    border-color: rgb(181, 169, 143);
    border-radius: 28px;
}
.gameplay-tutorial-nav {
    flex-shrink: 0;
    width: 58px;
    height: 88px;
    margin: 0 7px;
    padding: 0 0 7px 0;
    color: rgb(67, 59, 48);
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(242, 236, 217, 0.98);
    border-width: 2px;
    border-bottom-width: 7px;
    border-color: rgb(181, 169, 143);
    border-radius: 18px;
}
.gameplay-tutorial-nav:active {
    translate: 0 3px;
    border-bottom-width: 4px;
}
.gameplay-tutorial-nav:disabled { opacity: 0.28; }
.gameplay-tutorial-heading {
    width: 100%;
    min-height: 72px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.gameplay-tutorial-guide-tile {
    flex-shrink: 0;
    width: 62px; height: 62px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
    background-color: rgb(57, 144, 72);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: rgb(34, 100, 46);
    border-radius: 13px;
}
.gameplay-tutorial-guide-number {
    margin: 0; padding: 0;
    color: rgb(250, 246, 232);
    font-size: 37px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(47, 38, 29, 0.52);
}
.gameplay-tutorial-title {
    margin: 0; padding: 0;
    color: rgb(52, 45, 36);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gameplay-tutorial-message {
    width: 100%;
    min-height: 78px;
    margin: 8px 0 5px 0;
    padding: 0;
    color: rgb(77, 67, 53);
    font-size: 27px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.gameplay-tutorial-action-bubble {
    position: absolute;
    width: 68%;
    max-width: 540px;
    min-height: 74px;
    padding: 14px 20px;
    align-items: center;
    justify-content: center;
    background-color: rgba(239, 247, 222, 0.99);
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: rgb(99, 151, 86);
    border-radius: 20px;
}
.gameplay-tutorial-action {
    width: 100%;
    margin: 0;
    padding: 0;
    color: rgb(43, 105, 53);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}
.gameplay-tutorial-action-tail {
    position: absolute;
    width: 20px;
    height: 20px;
    background-color: rgb(239, 247, 222);
    border-width: 2px;
    border-color: rgb(99, 151, 86);
    rotate: 45deg;
}
.tutorial-tail-bottom {
    left: 50%;
    bottom: -12px;
    margin-left: -10px;
}
.tutorial-tail-top {
    left: 50%;
    top: -12px;
    margin-left: -10px;
}
.tutorial-tail-left {
    left: -12px;
    top: 50%;
    margin-top: -10px;
}
.tutorial-tail-right {
    right: -12px;
    top: 50%;
    margin-top: -10px;
}
.gameplay-tutorial-progress {
    width: 100%;
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.gameplay-tutorial-dot {
    width: 12px; height: 12px;
    margin: 0 7px;
    background-color: rgb(190, 180, 157);
    border-radius: 6px;
}
.gameplay-tutorial-dot-active {
    width: 25px;
    background-color: rgb(57, 144, 72);
}
.gameplay-tutorial-buttons {
    width: 100%;
    height: 70px;
    margin-top: 5px;
    flex-direction: row;
    justify-content: center;
}
.gameplay-tutorial-button {
    flex-grow: 1;
    height: 66px;
    margin: 0 8px;
    padding: 0;
    font-size: 27px;
    -unity-font-style: bold;
    border-width: 2px;
    border-bottom-width: 6px;
    border-radius: 14px;
}
.gameplay-tutorial-button:active { translate: 0 3px; border-bottom-width: 3px; }
.gameplay-tutorial-next {
    max-width: 420px;
    color: rgb(250, 246, 230);
    background-color: rgb(56, 143, 70);
    border-color: rgb(35, 99, 47);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(48, 39, 29, 0.45);
}
.gameplay-tutorial-next:disabled { opacity: 0.45; }.gameplay-modal {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
    align-items: center; justify-content: center;
}
.screen-hidden { display: none; }
.gameplay-modal-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
    margin: 0; padding: 0;
    background-color: rgba(40,34,27,0.68);
    border-width: 0; border-radius: 0;
}
.gameplay-modal-backdrop:hover, .gameplay-modal-backdrop:active, .gameplay-modal-backdrop:focus {
    background-color: rgba(40,34,27,0.68);
}
.gameplay-modal-card {
    width: 720px;
    padding: 48px 52px 45px 52px;
    align-items: center;
    background-color: rgb(244, 238, 218);
    border-width: 4px;
    border-bottom-width: 12px;
    border-color: rgb(184,172,146);
    border-radius: 29px;
}
.gameplay-solved-card {
    overflow: visible;
    border-color: rgb(74,139,76);
}
.gameplay-rate-card {
    max-width: 720px;
    padding-top: 40px;
}
.gameplay-rate-icon {
    width: 78px;
    height: 78px;
    margin: 0 0 20px 0;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_streak.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(218, 145, 27);
}
.gameplay-streak-celebration {
    position: absolute;
    left: 78px;
    right: 78px;
    top: -178px;
    height: 154px;
    padding: 11px 26px 12px 26px;
    align-items: center;
    justify-content: center;
    opacity: 0;
    translate: 0 18px;
    background-color: rgb(247, 239, 210);
    border-width: 3px;
    border-bottom-width: 9px;
    border-color: rgb(205, 151, 39);
    border-radius: 24px;
    transition-duration: 0.2s;
    transition-property: opacity, translate;
    transition-timing-function: ease-out;
}
.gameplay-streak-celebration-visible {
    opacity: 1;
    translate: 0 0;
}
.gameplay-streak-celebration-title {
    height: 29px;
    margin: 0;
    padding: 0;
    color: rgb(116, 87, 37);
    font-size: 23px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gameplay-streak-celebration-count-row {
    height: 65px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.gameplay-streak-celebration-star {
    width: 47px;
    height: 47px;
    margin: 0 12px 0 0;
    padding: 0;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_streak.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(220, 148, 24);
}
.gameplay-streak-celebration-number {
    min-width: 72px;
    margin: 0;
    padding: 0;
    color: rgb(54, 137, 68);
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-duration: 0.16s;
    transition-property: scale, color;
}
.gameplay-streak-number-pop {
    color: rgb(218, 145, 27);
    scale: 1.22 1.22;
}
.gameplay-streak-celebration-days {
    margin: 9px 0 0 11px;
    padding: 0;
    color: rgb(83, 69, 48);
    font-size: 23px;
    -unity-font-style: bold;
}
.gameplay-streak-celebration-reward {
    margin: 0;
    padding: 0;
    color: rgb(47, 127, 61);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.gameplay-modal-title {
    margin: 0; padding: 0;
    color: rgb(52,45,36);
    font-size: 58px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.gameplay-solved-title { color: rgb(51,127,64); }
.gameplay-modal-ornament {
    width: 420px; height: 66px;
    margin: 8px 0 14px 0;
    flex-direction: row;
    align-items: center;
}
.gameplay-solved-check {
    width: 60px; height: 60px; margin: 0 24px; padding: 0;
    color: rgb(53,137,67); font-size: 51px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.gameplay-reset-modal-icon {
    width: 56px; height: 56px; margin: 0 24px;
    -unity-background-scale-mode: scale-to-fit;
}
.gameplay-reset-modal-icon {
    background-image: url("project://database/Assets/Art/UI/Icons/icon_reset.png");
    -unity-background-image-tint-color: rgb(183,52,55);
}
.gameplay-modal-message {
    width: 100%; min-height: 94px;
    margin-bottom: 24px; padding: 0;
    color: rgb(79,68,54); font-size: 34px; white-space: normal;
    -unity-text-align: middle-center;
}
.gameplay-modal-button {
    width: 100%; height: 108px;
    margin: 0 0 17px 0; padding: 0;
    color: rgb(250,246,230); font-size: 39px;
    -unity-font-style: bold; -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(48,39,29,0.48);
    border-width: 3px; border-bottom-width: 8px; border-radius: 18px;
}
.gameplay-modal-button:active { translate: 0 4px; border-bottom-width: 4px; }
.gameplay-primary-button { background-color: rgb(56,143,70); border-color: rgb(35,99,47); }
.gameplay-danger-button { background-color: rgb(188,55,57); border-color: rgb(132,38,41); }
.gameplay-secondary-button {
    color: rgb(65,56,45);
    -unity-text-outline-width: 0;
    background-color: rgb(239,233,214);
    border-color: rgb(184,173,149);
}
