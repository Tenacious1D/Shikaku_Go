    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="safe-area" class="safe-area modern-ui">
            <ui:ScrollView class="modern-home-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement class="modern-home-content">
                    <ui:VisualElement name="brand-section" class="brand-section">
                        <ui:Label text="LITTLE ROOMS. BIG IDEAS." class="blueprint-eyebrow" />
                        <ui:VisualElement name="brand-mark" class="brand-mark-scatter">
