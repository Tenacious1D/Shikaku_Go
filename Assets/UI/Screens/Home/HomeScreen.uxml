                        <ui:Button name="shop-buy-sixty-button" text="Buy" class="shop-buy-button"/>
                    </ui:VisualElement>
                    <ui:Label text="Purchases are processed by your device store. Remove Ads purchases can be restored; bundle hints are granted once." class="shop-footnote"/>
                    <ui:Label name="shop-purchase-status" class="shop-purchase-status"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:Button name="shop-back-button" class="shop-back-button">
                <ui:VisualElement class="shop-back-icon"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="time-trial-screen" class="time-trial-screen screen-hidden">
            <ui:VisualElement class="time-trial-content">
                <ui:VisualElement class="time-trial-title-block">
                    <ui:VisualElement class="time-trial-title-row">
                        <ui:Label text="Time" class="time-trial-title-dark"/>
                        <ui:Label text="Trial" class="time-trial-title-blue"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="time-trial-title-ornament">
                        <ui:VisualElement class="time-trial-ornament-line"/>
                        <ui:VisualElement class="time-trial-ornament-icon"/>
                        <ui:VisualElement class="time-trial-ornament-line"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Complete as many floor plans as you can before the drafting clock runs out." class="time-trial-subtitle"/>
                <ui:Button name="time-trial-sprint-button" class="time-trial-mode-button time-trial-sprint">
                    <ui:VisualElement class="time-trial-mode-inner">
                        <ui:VisualElement class="time-trial-board-badge"><ui:Label text="3&#215;3" class="time-trial-board-label"/></ui:VisualElement>
                        <ui:VisualElement class="time-trial-mode-divider"/>
                        <ui:VisualElement class="time-trial-mode-copy">
                            <ui:Label text="Sprint" class="time-trial-mode-name"/>
                            <ui:Label text="30 seconds" class="time-trial-mode-time"/>
                            <ui:Label name="time-trial-sprint-best" text="Best: --" class="time-trial-mode-best"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="time-trial-play-shell"><ui:VisualElement class="ui-play-icon time-trial-play-icon" picking-mode="Ignore"/></ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="time-trial-quick-button" class="time-trial-mode-button time-trial-quick">
                    <ui:VisualElement class="time-trial-mode-inner">
                        <ui:VisualElement class="time-trial-board-badge"><ui:Label text="4&#215;4" class="time-trial-board-label"/></ui:VisualElement>
                        <ui:VisualElement class="time-trial-mode-divider"/>
                        <ui:VisualElement class="time-trial-mode-copy">
                            <ui:Label text="Quick" class="time-trial-mode-name"/>
                            <ui:Label text="60 seconds" class="time-trial-mode-time"/>
                            <ui:Label name="time-trial-quick-best" text="Best: --" class="time-trial-mode-best"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="time-trial-play-shell"><ui:VisualElement class="ui-play-icon time-trial-play-icon" picking-mode="Ignore"/></ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="time-trial-classic-button" class="time-trial-mode-button time-trial-classic">
                    <ui:VisualElement class="time-trial-mode-inner">
                        <ui:VisualElement class="time-trial-board-badge"><ui:Label text="5&#215;5" class="time-trial-board-label"/></ui:VisualElement>
                        <ui:VisualElement class="time-trial-mode-divider"/>
                        <ui:VisualElement class="time-trial-mode-copy">
                            <ui:Label text="Classic" class="time-trial-mode-name"/>
                            <ui:Label text="90 seconds" class="time-trial-mode-time"/>
                            <ui:Label name="time-trial-classic-best" text="Best: --" class="time-trial-mode-best"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="time-trial-play-shell"><ui:VisualElement class="ui-play-icon time-trial-play-icon" picking-mode="Ignore"/></ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="time-trial-expert-button" class="time-trial-mode-button time-trial-expert">
                    <ui:VisualElement class="time-trial-mode-inner">
                        <ui:VisualElement class="time-trial-board-badge"><ui:Label text="6&#215;6" class="time-trial-board-label"/></ui:VisualElement>
                        <ui:VisualElement class="time-trial-mode-divider"/>
                        <ui:VisualElement class="time-trial-mode-copy">
                            <ui:Label text="Expert" class="time-trial-mode-name"/>
                            <ui:Label text="120 seconds" class="time-trial-mode-time"/>
                            <ui:Label name="time-trial-expert-best" text="Best: --" class="time-trial-mode-best"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="time-trial-play-shell"><ui:VisualElement class="ui-play-icon time-trial-play-icon" picking-mode="Ignore"/></ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="time-trial-back-button" class="time-trial-back-button">
                <ui:VisualElement class="time-trial-back-icon"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="free-play-screen" class="free-play-screen screen-hidden">
            <ui:VisualElement name="free-play-pack-view" class="free-play-view">
                <ui:VisualElement class="free-play-drawing-header">
                    <ui:VisualElement class="free-play-header-index">
                        <ui:Label text="DRAWING ARCHIVE" class="free-play-header-kicker"/>
                        <ui:Label text="FP-000" class="free-play-header-sheet"/>
                    </ui:VisualElement>
                    <ui:Label text="FREE PLAY" class="free-play-drawing-title"/>
                    <ui:VisualElement class="free-play-header-rule"/>
                    <ui:VisualElement class="free-play-header-meta">
                        <ui:VisualElement class="free-play-meta-field">
                            <ui:Label text="FILE" class="free-play-meta-caption"/>
                            <ui:Label text="PLAN LIBRARY" class="free-play-meta-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="free-play-meta-field">
                            <ui:Label text="STATUS" class="free-play-meta-caption"/>
                            <ui:Label text="OPEN" class="free-play-meta-value free-play-meta-accent"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="SELECT PROJECT BINDER" class="free-play-section-label"/>
                <ui:ScrollView name="free-play-pack-scroll" mode="Vertical" class="free-play-scroll-view free-play-pack-scroll">
                    <ui:VisualElement name="free-play-pack-list" class="free-play-pack-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="free-play-size-view" class="free-play-view screen-hidden">
                <ui:VisualElement class="free-play-drawing-header free-play-context-header">
                    <ui:VisualElement class="free-play-header-index">
                        <ui:Label text="PROJECT BINDER" class="free-play-header-kicker"/>
                        <ui:Label text="FP-100" class="free-play-header-sheet"/>
                    </ui:VisualElement>
                    <ui:Label name="free-play-size-pack-title" text="Classical 1" class="free-play-context-title"/>
                    <ui:VisualElement class="free-play-header-rule"/>
                    <ui:VisualElement class="free-play-header-meta">
                        <ui:VisualElement class="free-play-meta-field">
                            <ui:Label text="DRAWING TYPE" class="free-play-meta-caption"/>
                            <ui:Label text="FLOOR PLANS" class="free-play-meta-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="free-play-meta-field">
                            <ui:Label text="UNITS" class="free-play-meta-caption"/>
                            <ui:Label text="GRID CELLS" class="free-play-meta-value"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="SELECT FLOOR PLATE" class="free-play-section-label"/>
                <ui:ScrollView name="free-play-size-scroll" mode="Vertical" class="free-play-scroll-view">
                    <ui:VisualElement name="free-play-size-list" class="free-play-size-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="free-play-level-view" class="free-play-view screen-hidden">
                <ui:VisualElement class="free-play-drawing-header free-play-level-header">
                    <ui:VisualElement class="free-play-header-index">
                        <ui:Label text="PLAN INDEX" class="free-play-header-kicker"/>
                        <ui:Label text="FP-200" class="free-play-header-sheet"/>
                    </ui:VisualElement>
                    <ui:Label name="free-play-level-pack-label" text="Classical 1" class="free-play-context-title free-play-level-pack-label"/>
                    <ui:VisualElement class="free-play-header-rule"/>
                    <ui:VisualElement class="free-play-header-meta free-play-level-meta">
                        <ui:VisualElement class="free-play-meta-field">
                            <ui:Label text="GRID" class="free-play-meta-caption"/>
                            <ui:Label name="free-play-level-title" text="5&#215;5" class="free-play-meta-value free-play-level-title"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="free-play-meta-field free-play-progress-field">
                            <ui:Label text="APPROVALS" class="free-play-meta-caption"/>
                            <ui:Label name="free-play-level-progress" text="0 of 50 completed" class="free-play-meta-value free-play-level-progress"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="free-play-continue-button" class="free-play-continue-button">
                    <ui:VisualElement class="free-play-continue-marker" picking-mode="Ignore">
                        <ui:Label text="&#9654;" class="free-play-continue-marker-label" picking-mode="Ignore"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="free-play-continue-copy" picking-mode="Ignore">
                        <ui:Label text="ACTIVE DRAWING" class="free-play-continue-caption" picking-mode="Ignore"/>
                        <ui:Label name="free-play-continue-label" text="Resume Plan 01" class="free-play-continue-label" picking-mode="Ignore"/>
                    </ui:VisualElement>
                    <ui:Label text="OPEN" class="free-play-continue-action" picking-mode="Ignore"/>
                </ui:Button>
                <ui:Label text="DRAWING SHEETS" class="free-play-section-label free-play-level-section-label"/>
                <ui:ScrollView name="free-play-level-scroll" mode="Vertical" class="free-play-scroll-view">
                    <ui:VisualElement class="free-play-level-scroll-content">
                        <ui:VisualElement name="free-play-level-grid" class="free-play-level-grid"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:Button name="free-play-back-button" class="free-play-back-button">
                <ui:VisualElement class="free-play-back-icon"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="adventure-screen" class="adventure-screen screen-hidden">
            <ui:VisualElement name="adventure-map-view" class="adventure-view">
                <ui:VisualElement class="adventure-title-block">
                    <ui:Label text="Adventure" class="adventure-title"/>
                    <ui:VisualElement class="adventure-title-ornament">
                        <ui:VisualElement class="adventure-ornament-line"/>
                        <ui:VisualElement class="adventure-ornament-icon"/>
                        <ui:VisualElement class="adventure-ornament-line"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Choose a project" class="adventure-subtitle"/>
                <ui:VisualElement class="adventure-progress-chip">
                    <ui:Label name="adventure-map-progress" text="0 of 10 chapters completed" class="adventure-progress-label"/>
                </ui:VisualElement>
                <ui:ScrollView name="adventure-map-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="adventure-scroll-view">
                    <ui:VisualElement class="adventure-map-content">
                        <ui:VisualElement name="adventure-map-root" class="adventure-map-root"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="adventure-level-view" class="adventure-view screen-hidden">
                <ui:VisualElement class="adventure-level-header">
                    <ui:Label name="adventure-level-title" text="Chapter 1" class="adventure-level-title"/>
                    <ui:VisualElement class="adventure-title-ornament">
                        <ui:VisualElement class="adventure-ornament-line"/>
                        <ui:VisualElement class="adventure-ornament-icon"/>
                        <ui:VisualElement class="adventure-ornament-line"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Choose a puzzle" class="adventure-subtitle"/>
                <ui:VisualElement class="adventure-progress-chip adventure-level-progress-chip">
                    <ui:Label name="adventure-level-progress" text="0 of 15 completed" class="adventure-progress-label"/>
                </ui:VisualElement>
                <ui:Button name="adventure-continue-button" class="adventure-continue-button">
                    <ui:VisualElement class="adventure-continue-icon">
                        <ui:VisualElement class="ui-play-icon adventure-continue-icon-label" picking-mode="Ignore"/>
                    </ui:VisualElement>
                    <ui:Label name="adventure-continue-label" text="Continue &#8226; Puzzle 1" class="adventure-continue-label"/>
                </ui:Button>
                <ui:ScrollView name="adventure-level-scroll" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="adventure-scroll-view">
                    <ui:VisualElement class="adventure-level-scroll-content">
                        <ui:VisualElement name="adventure-level-grid" class="adventure-level-grid"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:Button name="adventure-back-button" class="adventure-back-button">
                <ui:VisualElement class="adventure-back-icon"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="privacy-welcome-screen" class="privacy-welcome-screen screen-hidden">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="privacy-welcome-scroll">
                <ui:VisualElement class="privacy-welcome-content">
                    <ui:VisualElement class="privacy-welcome-brand-mark">
                        <ui:Label text="1" class="privacy-welcome-brand-number"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="rivet rivet-welcome" picking-mode="Ignore"/>
                <ui:Label text="Welcome to Shikaku Go" class="privacy-welcome-title"/>
                    <ui:Label text="By continuing, you agree to our Terms of Service and acknowledge our Privacy Policy." class="privacy-welcome-legal-copy"/>
                    <ui:VisualElement class="privacy-welcome-legal-links">
                        <ui:Button name="privacy-welcome-terms-button" text="Terms of Service" class="privacy-welcome-link-button"/>
                        <ui:VisualElement class="privacy-welcome-link-divider"/>
                        <ui:Button name="privacy-welcome-privacy-policy-button" text="Privacy Policy" class="privacy-welcome-link-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="privacy-welcome-analytics-card">
                        <ui:VisualElement class="privacy-welcome-analytics-copy">
                            <ui:Label text="Help improve Shikaku Go" class="privacy-welcome-analytics-title"/>
                            <ui:Label text="Share optional usage analytics to help improve Shikaku Go. No name or email is collected." class="privacy-welcome-analytics-note"/>
                        </ui:VisualElement>
                        <ui:Toggle name="privacy-welcome-analytics-toggle" class="settings-switch privacy-welcome-toggle"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="privacy-welcome-analytics-card">
                        <ui:VisualElement class="privacy-welcome-analytics-copy">
                            <ui:Label text="Allow notifications" class="privacy-welcome-analytics-title"/>
                            <ui:Label text="Receive an optional puzzle reminder at 6:00 PM local time. You can change this later in Settings." class="privacy-welcome-analytics-note"/>
                        </ui:VisualElement>
                        <ui:Toggle name="privacy-welcome-notifications-toggle" class="settings-switch privacy-welcome-toggle"/>
                    </ui:VisualElement>
                    <ui:Button name="privacy-welcome-continue-button" text="Continue" class="privacy-welcome-continue-button"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="analytics-delete-modal" class="analytics-modal screen-hidden">
            <ui:VisualElement class="analytics-modal-backdrop"/>
            <ui:VisualElement class="analytics-modal-card analytics-delete-card">
                <ui:Label text="Delete Analytics Data?" class="analytics-modal-title"/>
                <ui:Label text="This asks Unity Analytics to delete the usage data associated with this installation and turns analytics off. The request is retried automatically if you are offline." class="analytics-modal-copy"/>
                <ui:VisualElement class="analytics-modal-actions">
                    <ui:Button name="analytics-delete-cancel-button" text="Cancel" class="analytics-modal-button analytics-secondary-button"/>
                    <ui:Button name="analytics-delete-confirm-button" text="Delete Data" class="analytics-modal-button analytics-danger-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="streak-restore-modal" class="analytics-modal screen-hidden">
            <ui:VisualElement class="analytics-modal-backdrop"/>
            <ui:VisualElement class="analytics-modal-card streak-restore-card">
                <ui:VisualElement class="rate-modal-icon" picking-mode="Ignore"/>
                <ui:VisualElement class="rivet rivet-hint" picking-mode="Ignore"/>
                <ui:Label text="Save Your Streak" class="analytics-modal-title"/>
                <ui:Label name="streak-restore-copy" text="Restore your streak, then complete a puzzle today to continue it." class="analytics-modal-copy streak-restore-copy"/>
                <ui:VisualElement class="analytics-modal-actions streak-restore-actions">
                    <ui:Button name="streak-restore-ad-button" text="Watch Ad" class="analytics-modal-button analytics-primary-button streak-restore-button"/>
                    <ui:Button name="streak-restore-hint-button" text="Use 1 Hint" class="analytics-modal-button analytics-secondary-button streak-restore-button"/>
                    <ui:Button name="streak-restore-decline-button" text="Let Streak End" class="analytics-modal-button analytics-secondary-button streak-restore-button streak-restore-decline-button"/>
                </ui:VisualElement>
                <ui:Label name="streak-restore-status" text="" class="streak-restore-status"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rate-prompt-modal" class="analytics-modal screen-hidden">
            <ui:VisualElement class="analytics-modal-backdrop"/>
            <ui:VisualElement class="analytics-modal-card rate-modal-card">
                <ui:VisualElement class="rate-modal-icon" picking-mode="Ignore"/>
                <ui:VisualElement class="rivet rivet-welcome rivet-small" picking-mode="Ignore"/>
                <ui:Label text="Rate Shikaku Go" class="analytics-modal-title"/>
                <ui:Label text="You&#8217;ve reached a 3-day streak! If you&#8217;re enjoying Shikaku Go, would you take a moment to rate it?" class="analytics-modal-copy"/>
                <ui:VisualElement class="analytics-modal-actions">
                    <ui:Button name="rate-prompt-later-button" text="Not Now" class="analytics-modal-button analytics-secondary-button"/>
                    <ui:Button name="rate-prompt-rate-button" text="Rate Shikaku Go" class="analytics-modal-button analytics-primary-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
