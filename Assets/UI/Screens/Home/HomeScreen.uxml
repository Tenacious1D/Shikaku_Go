    <Style src="project://database/Assets/UI/Screens/FreePlay/FreePlayScreen.uss?fileID=7433441132597879392&amp;guid=1fbf38c383f84187a3c8da1ce16201fe&amp;type=3#FreePlayScreen"/>
    <Style src="project://database/Assets/UI/Screens/Adventure/AdventureScreen.uss"/>
    <Style src="project://database/Assets/UI/Themes/DarkTheme.uss"/>
    <Style src="project://database/Assets/UI/Themes/BlueprintTheme.uss"/>
    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="safe-area" class="safe-area">
            <ui:VisualElement name="brand-section" class="brand-section">
              <ui:Label text="BLUEPRINT PUZZLES" class="blueprint-eyebrow"/>
              <ui:VisualElement name="brand-mark" class="brand-mark-scatter">
                <ui:VisualElement class="brand-logo-tile brand-logo-tile-blank scatter-blank"/>
                <ui:VisualElement class="brand-logo-tile brand-logo-tile-grey scatter-one">
                  <ui:Label text="1" class="brand-logo-number"/>
                </ui:VisualElement>
                <ui:VisualElement class="brand-logo-tile brand-logo-tile-red scatter-two">
                  <ui:Label text="2" class="brand-logo-number"/>
                </ui:VisualElement>
                <ui:VisualElement class="brand-logo-tile brand-logo-tile-green scatter-three">
                  <ui:Label text="3" class="brand-logo-number"/>
                </ui:VisualElement>
                <ui:VisualElement class="brand-logo-tile brand-logo-tile-blue scatter-four">
                  <ui:Label text="4" class="brand-logo-number"/>
                </ui:VisualElement>
                <ui:VisualElement class="brand-logo-tile brand-logo-tile-gold scatter-five">
                  <ui:Label text="5" class="brand-logo-number"/>
                </ui:VisualElement>
              </ui:VisualElement>
                <ui:VisualElement class="brand-title-row">
                    <ui:Label text="Shikaku" class="brand-title brand-title-dark"/>
                    <ui:Label text="Go" class="brand-title brand-title-gold"/>
                </ui:VisualElement>
                <ui:VisualElement class="tagline-row">
                    <ui:VisualElement class="tagline-rule"/>
                    <ui:Label text="DRAW ROOMS. COMPLETE THE FLOOR." class="tagline"/>
                    <ui:VisualElement class="tagline-rule"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="primary-actions" class="primary-actions">
                <ui:VisualElement class="home-feature-row">
                    <ui:Button name="adventure-button" class="menu-button main-menu-button adventure-button home-adventure-feature">
                        <ui:VisualElement class="menu-button-inner">
                            <ui:VisualElement class="menu-button-icon icon-adventure"/>
                            <ui:VisualElement class="menu-button-divider"/>
                            <ui:VisualElement class="menu-button-copy"><ui:Label text="Adventure" class="menu-button-label"/><ui:Label text="Build through guided floors" class="menu-button-note"/></ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:VisualElement class="home-compact-stack">
                        <ui:Button name="free-play-button" class="menu-button main-menu-button free-play-button home-compact-button">
                            <ui:VisualElement class="menu-button-inner">
                                <ui:VisualElement class="menu-button-icon icon-free-play"/>
                                <ui:VisualElement class="menu-button-divider"/>
                                <ui:VisualElement class="menu-button-copy"><ui:Label text="Free Play" class="menu-button-label"/><ui:Label text="Open any plan set" class="menu-button-note"/></ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="time-trial-button" class="menu-button main-menu-button time-trial-button home-compact-button">
                            <ui:VisualElement class="menu-button-inner">
                                <ui:VisualElement class="menu-button-icon icon-time-trial"/>
                                <ui:VisualElement class="menu-button-divider"/>
                                <ui:VisualElement class="menu-button-copy"><ui:Label text="Time Trial" class="menu-button-label"/><ui:Label text="Draft against the clock" class="menu-button-note"/></ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="daily-button" class="menu-button main-menu-button daily-button home-daily-wide">
                    <ui:VisualElement class="menu-button-inner">
                        <ui:VisualElement class="menu-button-icon icon-daily"/>
                        <ui:VisualElement class="menu-button-divider"/>
                        <ui:VisualElement class="menu-button-copy"><ui:Label text="Daily Puzzles" class="menu-button-label"/><ui:Label text="Complete today&apos;s inspection" class="menu-button-note"/></ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="secondary-actions" class="secondary-actions">
                <ui:Button name="shop-button" class="menu-button secondary-menu-button">
                    <ui:VisualElement class="secondary-button-icon icon-shop"/>
                    <ui:Label text="Shop" class="secondary-button-label"/>
                </ui:Button>
                <ui:Button name="settings-button" class="menu-button secondary-menu-button">
                    <ui:VisualElement class="secondary-button-icon icon-settings"/>
                    <ui:Label text="Settings" class="secondary-button-label"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="daily-screen" class="daily-screen screen-hidden">
            <ui:Button name="daily-back-button" class="daily-square-button daily-back-button">
                <ui:VisualElement class="daily-back-icon"/>
            </ui:Button>
            <ui:VisualElement class="daily-content">
                <ui:VisualElement class="daily-title-block">
                    <ui:Label text="Daily" class="daily-title daily-title-dark"/>
                    <ui:Label text="Puzzles" class="daily-title daily-title-gold"/>
                </ui:VisualElement>
                <ui:VisualElement class="daily-title-ornament">
                    <ui:VisualElement class="daily-ornament-line"/>
                    <ui:VisualElement class="daily-date-icon"/>
                    <ui:VisualElement class="daily-ornament-line"/>
                </ui:VisualElement>
                <ui:VisualElement class="daily-info-row">
                    <ui:VisualElement class="daily-date-chip">
                        <ui:Label name="daily-today-date" text="July 29, 2026" class="daily-date-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="daily-streak-chip" picking-mode="Ignore">
                        <ui:VisualElement class="daily-streak-icon" picking-mode="Ignore"/>
                        <ui:Label name="daily-streak-count" text="0" class="daily-streak-count" picking-mode="Ignore"/>
                        <ui:Label text="DAY STREAK" class="daily-streak-label" picking-mode="Ignore"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="daily-play-today-button" class="daily-play-button">
                    <ui:VisualElement class="daily-play-inner">
                        <ui:VisualElement class="daily-play-icon-box">
                            <ui:VisualElement class="ui-play-icon daily-play-icon" picking-mode="Ignore"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="daily-play-divider"/>
                        <ui:Label text="Play Today&#8217;s Puzzle" class="daily-play-label"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:VisualElement class="daily-calendar-card">
                    <ui:VisualElement class="daily-month-row">
                        <ui:Button name="daily-previous-month-button" text="&#8592;" class="daily-square-button daily-month-button"/>
                        <ui:Label name="daily-month-title" text="July 2026" class="daily-month-title"/>
                        <ui:Button name="daily-next-month-button" text="&#8594;" class="daily-square-button daily-month-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="daily-weekday-row">
                        <ui:Label text="Sun" class="daily-weekday"/>
                        <ui:Label text="Mon" class="daily-weekday"/>
                        <ui:Label text="Tue" class="daily-weekday"/>
                        <ui:Label text="Wed" class="daily-weekday"/>
                        <ui:Label text="Thu" class="daily-weekday"/>
                        <ui:Label text="Fri" class="daily-weekday"/>
                        <ui:Label text="Sat" class="daily-weekday"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="daily-calendar-grid" class="daily-calendar-grid"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="daily-difficulty-modal" class="daily-modal screen-hidden">
                <ui:Button name="daily-modal-dismiss-button" class="daily-modal-backdrop"/>
                <ui:VisualElement class="daily-modal-card">
                    <ui:Button name="daily-modal-close-button" text="&#215;" class="daily-modal-close"/>
                    <ui:Label name="daily-modal-title" text="Today&#8217;s Puzzles" class="daily-modal-title"/>
                    <ui:Label name="daily-modal-date" text="July 29, 2026" class="daily-modal-date"/>
                    <ui:Label text="Choose a difficulty" class="daily-modal-prompt"/>
                    <ui:Button name="daily-easy-button" text="Easy" class="daily-difficulty-button daily-easy-button"/>
                    <ui:Button name="daily-medium-button" text="Medium" class="daily-difficulty-button daily-medium-button"/>
                    <ui:Button name="daily-hard-button" text="Hard" class="daily-difficulty-button daily-hard-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings-screen" class="settings-screen screen-hidden">
            <ui:VisualElement name="settings-main-view" class="settings-main-view">
            <ui:VisualElement class="settings-content">
                <ui:VisualElement class="settings-title-block">
                    <ui:VisualElement class="settings-title-row">
                        <ui:Label text="Settings" class="settings-title"/>
