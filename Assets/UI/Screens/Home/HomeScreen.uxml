                                <ui:Label text="&#8250;" class="settings-link-chevron"/>
                            </ui:Button>
                            <ui:Button name="settings-privacy-preferences-button" class="settings-link-button">
                                <ui:Label text="Privacy Preferences" class="settings-link-label"/>
                                <ui:Label text="&#8250;" class="settings-link-chevron"/>
                            </ui:Button>
                            <ui:Button name="settings-privacy-policy-button" class="settings-link-button">
                                <ui:Label text="Privacy Policy" class="settings-link-label"/>
