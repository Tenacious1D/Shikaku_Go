                            <ui:VisualElement class="brand-logo-tile brand-logo-tile-green scatter-three">
                                <ui:Label text="3" class="brand-logo-number" />
                            </ui:VisualElement>
                            <ui:VisualElement class="brand-logo-tile brand-logo-tile-blue scatter-four">
                                <ui:Label text="4" class="brand-logo-number" />
                            </ui:VisualElement>
