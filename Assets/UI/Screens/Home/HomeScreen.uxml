        <ui:VisualElement name="privacy-welcome-screen" class="privacy-welcome-screen screen-hidden modern-ui">
            <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="privacy-welcome-scroll">
                <ui:VisualElement class="privacy-welcome-content">
                    <ui:VisualElement class="privacy-welcome-brand-mark">
                        <ui:Label text="1" class="privacy-welcome-brand-number" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rivet rivet-welcome" picking-mode="Ignore" />
                    <ui:Label text="Welcome to Shikaku Go" class="privacy-welcome-title" />
                    <ui:Label text="By continuing, you agree to our Terms of Service and acknowledge our Privacy Policy." class="privacy-welcome-legal-copy" />
                    <ui:VisualElement class="privacy-welcome-legal-links">
                        <ui:Button name="privacy-welcome-terms-button" text="Terms of Service" class="privacy-welcome-link-button" />
                        <ui:VisualElement class="privacy-welcome-link-divider" />
                        <ui:Button name="privacy-welcome-privacy-policy-button" text="Privacy Policy" class="privacy-welcome-link-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="privacy-welcome-analytics-card">
                        <ui:VisualElement class="privacy-welcome-analytics-copy">
                            <ui:Label text="Help improve Shikaku Go" class="privacy-welcome-analytics-title" />
                            <ui:Label text="Share optional usage analytics to help improve Shikaku Go. No name or email is collected." class="privacy-welcome-analytics-note" />
                        </ui:VisualElement>
                        <ui:Toggle name="privacy-welcome-analytics-toggle" class="settings-switch privacy-welcome-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement class="privacy-welcome-analytics-card">
                        <ui:VisualElement class="privacy-welcome-analytics-copy">
                            <ui:Label text="Allow notifications" class="privacy-welcome-analytics-title" />
                            <ui:Label text="Receive an optional puzzle reminder at 6:00 PM local time. You can change this later in Settings." class="privacy-welcome-analytics-note" />
                        </ui:VisualElement>
                        <ui:Toggle name="privacy-welcome-notifications-toggle" class="settings-switch privacy-welcome-toggle" />
                    </ui:VisualElement>
                    <ui:Button name="privacy-welcome-continue-button" text="Continue" class="privacy-welcome-continue-button" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="analytics-delete-modal" class="analytics-modal screen-hidden modern-ui">
            <ui:VisualElement class="analytics-modal-backdrop" />
            <ui:VisualElement class="analytics-modal-card analytics-delete-card">
                <ui:Label text="Delete Analytics Data?" class="analytics-modal-title" />
                <ui:Label text="This asks Unity Analytics to delete the usage data associated with this installation and turns analytics off. The request is retried automatically if you are offline." class="analytics-modal-copy" />
                <ui:VisualElement class="analytics-modal-actions">
                    <ui:Button name="analytics-delete-cancel-button" text="Cancel" class="analytics-modal-button analytics-secondary-button" />
                    <ui:Button name="analytics-delete-confirm-button" text="Delete Data" class="analytics-modal-button analytics-danger-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="streak-restore-modal" class="analytics-modal screen-hidden modern-ui">
            <ui:VisualElement class="analytics-modal-backdrop" />
            <ui:VisualElement class="analytics-modal-card streak-restore-card">
                <ui:VisualElement class="rate-modal-icon" picking-mode="Ignore" />
                <ui:VisualElement class="rivet rivet-hint" picking-mode="Ignore" />
                <ui:Label text="Save Your Streak" class="analytics-modal-title" />
                <ui:Label name="streak-restore-copy" text="Restore your streak, then complete a puzzle today to continue it." class="analytics-modal-copy streak-restore-copy" />
                <ui:VisualElement class="analytics-modal-actions streak-restore-actions">
                    <ui:Button name="streak-restore-ad-button" text="Watch Ad" class="analytics-modal-button analytics-primary-button streak-restore-button" />
                    <ui:Button name="streak-restore-hint-button" text="Use 1 Hint" class="analytics-modal-button analytics-secondary-button streak-restore-button" />
                    <ui:Button name="streak-restore-decline-button" text="Let Streak End" class="analytics-modal-button analytics-secondary-button streak-restore-button streak-restore-decline-button" />
                </ui:VisualElement>
                <ui:Label name="streak-restore-status" text="" class="streak-restore-status" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rate-prompt-modal" class="analytics-modal screen-hidden modern-ui">
            <ui:VisualElement class="analytics-modal-backdrop" />
            <ui:VisualElement class="analytics-modal-card rate-modal-card">
                <ui:VisualElement class="rate-modal-icon" picking-mode="Ignore" />
                <ui:VisualElement class="rivet rivet-welcome rivet-small" picking-mode="Ignore" />
                <ui:Label text="Rate Shikaku Go" class="analytics-modal-title" />
                <ui:Label text="You’ve reached a 3-day streak! If you’re enjoying Shikaku Go, would you take a moment to rate it?" class="analytics-modal-copy" />
                <ui:VisualElement class="analytics-modal-actions">
                    <ui:Button name="rate-prompt-later-button" text="Not Now" class="analytics-modal-button analytics-secondary-button" />
                    <ui:Button name="rate-prompt-rate-button" text="Rate Shikaku Go" class="analytics-modal-button analytics-primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>