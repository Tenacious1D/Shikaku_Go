                        <ui:VisualElement class="daily-weekday-row">
                            <ui:Label text="SUN" class="daily-weekday" />
                            <ui:Label text="MON" class="daily-weekday" />
                            <ui:Label text="TUE" class="daily-weekday" />
                            <ui:Label text="WED" class="daily-weekday" />
                            <ui:Label text="THU" class="daily-weekday" />
                            <ui:Label text="FRI" class="daily-weekday" />
                            <ui:Label text="SAT" class="daily-weekday" />
