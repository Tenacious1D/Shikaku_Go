                        <ui:VisualElement class="settings-ornament-line"/>
                        <ui:VisualElement class="settings-title-icon"/>
                        <ui:VisualElement class="settings-ornament-line"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="settings-scroll-view" mode="Vertical" class="settings-scroll-view">
                    <ui:VisualElement class="settings-scroll-content">
                        <ui:VisualElement class="settings-section-card">
                            <ui:VisualElement class="settings-section-heading-row">
                                <ui:VisualElement class="settings-section-accent"/>
                                <ui:Label text="GAMEPLAY" class="settings-section-heading"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="settings-control-row settings-appearance-row">
                                <ui:Label text="Appearance" class="settings-control-label"/>
                                <ui:DropdownField name="settings-appearance-dropdown" class="settings-appearance-dropdown"/>
