                            <ui:VisualElement class="tagline-rule" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="primary-actions" class="primary-actions">
                        <ui:VisualElement class="home-feature-row">
                            <ui:Button name="adventure-button" class="menu-button main-menu-button adventure-button home-adventure-feature">
                                <ui:VisualElement class="menu-button-inner">
                                    <ui:VisualElement class="menu-button-icon icon-adventure" />
                                    <ui:VisualElement class="menu-button-divider" />
                                    <ui:VisualElement class="menu-button-copy">
