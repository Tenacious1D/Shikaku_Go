.time-trial-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
}

.time-trial-content {
    flex-grow: 1;
    width: 100%;
    max-width: 920px;
    min-height: 100%;
    padding-top: 88px;
    padding-right: 38px;
    padding-bottom: 44px;
    padding-left: 38px;
    align-items: center;
}

.time-trial-back-button {
    position: absolute;
    left: 38px;
    top: 63px;
    width: 104px;
    height: 108px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(241, 237, 221);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 8px;
    border-left-width: 3px;
    border-color: rgb(190, 182, 161);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.time-trial-back-button:active {
    translate: 0 5px;
    border-bottom-width: 4px;
}

.time-trial-back-icon {
    width: 66px;
    height: 66px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.time-trial-title-block {
    flex-shrink: 0;
    width: 680px;
    height: 270px;
    align-items: center;
    justify-content: center;
}

.time-trial-title-row {
    height: 174px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.time-trial-title-icon {
    width: 104px;
    height: 104px;
    margin-right: 25px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_time_trial.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(45, 44, 40);
}

.time-trial-title-dark,
.time-trial-title-blue {
    margin: 0;
    padding: 0;
    font-size: 103px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 7px;
}

.time-trial-title-dark {
    color: rgb(42, 42, 39);
    -unity-text-outline-color: rgb(247, 242, 225);
}

.time-trial-title-blue {
    margin-left: 20px;
    color: rgb(42, 111, 176);
    -unity-text-outline-color: rgb(220, 234, 244);
}

.time-trial-title-ornament {
    width: 470px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.time-trial-ornament-line {
    flex-grow: 1;
    height: 2px;
    background-color: rgba(145, 134, 113, 0.45);
}

.time-trial-ornament-icon {
    width: 44px;
    height: 44px;
    margin-right: 25px;
    margin-left: 25px;
    background-image: url("project://database/Assets/Art/UI/Icons/icon_time_trial.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(42, 111, 176);
}
.time-trial-subtitle {
    width: 100%;
    max-width: 760px;
    min-height: 78px;
    margin: 0 0 24px 0;
    padding-right: 28px;
    padding-left: 28px;
    color: rgb(94, 80, 61);
    font-size: 31px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.time-trial-mode-button {
    flex-shrink: 0;
    width: 100%;
    max-width: 780px;
    height: 238px;
    margin: 0 0 28px 0;
    padding: 0;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 11px;
    border-left-width: 3px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    transition-duration: 0.08s;
    transition-property: translate;
}

.time-trial-mode-button:active {
    translate: 0 6px;
    border-bottom-width: 5px;
}

.time-trial-mode-button:disabled {
    opacity: 0.62;
}

.time-trial-quick {
    background-color: rgb(42, 111, 176);
    border-color: rgb(28, 78, 128);
}

.time-trial-classic {
    background-color: rgb(186, 56, 58);
    border-color: rgb(132, 38, 41);
}

.time-trial-expert {
    background-color: rgb(226, 153, 22);
    border-color: rgb(166, 105, 12);
}

.time-trial-mode-inner {
    flex-grow: 1;
    margin: 10px;
    padding-right: 22px;
    padding-left: 22px;
    flex-direction: row;
    align-items: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: rgba(255, 255, 255, 0.32);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-right-radius: 17px;
    border-bottom-left-radius: 17px;
}

.time-trial-board-badge {
    flex-shrink: 0;
    width: 142px;
    height: 142px;
    align-items: center;
    justify-content: center;
    background-color: rgb(247, 242, 225);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 7px;
    border-left-width: 3px;
    border-color: rgb(201, 191, 168);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
}

.time-trial-board-label {
    margin: 0;
    padding: 0;
    color: rgb(58, 54, 47);
    font-size: 49px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.time-trial-mode-divider {
    flex-shrink: 0;
    width: 2px;
    height: 145px;
    margin-right: 28px;
    margin-left: 28px;
    background-color: rgba(255, 255, 255, 0.45);
}

.time-trial-mode-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.time-trial-mode-name {
    margin: 0 0 4px 0;
    padding: 0;
    color: rgb(255, 250, 234);
    font-size: 49px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(49, 40, 29, 0.45);
}

.time-trial-mode-time {
    margin: 0 0 4px 0;
    padding: 0;
    color: rgba(255, 250, 234, 0.92);
    font-size: 29px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.time-trial-mode-best {
    margin: 0;
    padding: 0;
    color: rgb(255, 240, 181);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.time-trial-play-shell {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    margin-left: 16px;
    align-items: center;
    justify-content: center;
    background-color: rgb(247, 242, 225);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 6px;
    border-left-width: 2px;
    border-color: rgb(201, 191, 168);
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    border-bottom-right-radius: 44px;
    border-bottom-left-radius: 44px;
}

.time-trial-play-icon {
    width: 38px;
    height: 44px;
    margin-left: 6px;
    -unity-background-image-tint-color: rgb(55, 54, 48);
}
