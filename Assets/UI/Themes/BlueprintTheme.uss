}

.theme-dark .free-play-level-next {
    background-color: rgb(68, 57, 28);
    border-color: rgb(236, 180, 43);
}

.theme-dark .free-play-level-next .free-play-level-title-strip {
    background-color: rgb(91, 70, 25);
