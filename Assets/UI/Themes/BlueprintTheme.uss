}

.theme-dark .free-play-continue-button {
    background-color: rgb(76, 61, 27);
    border-color: rgb(201, 150, 29);
    border-left-color: rgb(239, 181, 41);
}

.theme-dark .free-play-continue-button:hover {
    background-color: rgb(91, 72, 30);
}

.theme-dark .free-play-continue-marker {
    background-color: rgb(22, 116, 155);
}

.theme-dark .free-play-continue-caption {
    color: rgb(238, 190, 73);
}

.theme-dark .free-play-continue-label {
    color: rgb(244, 239, 215);
    -unity-text-outline-width: 0;
}

.theme-dark .free-play-continue-action {
    color: rgb(137, 213, 228);
}

.theme-dark .free-play-level-grid-panel {
    background-color: rgba(7, 37, 65, 0.86);
    border-color: rgba(80, 171, 197, 0.66);
}

.theme-dark .free-play-level-title-strip {
    background-color: rgb(16, 66, 98);
    border-bottom-color: rgb(66, 145, 174);
}

.theme-dark .free-play-level-plan-label,
.theme-dark .free-play-level-sheet-label,
.theme-dark .free-play-level-ready-label {
