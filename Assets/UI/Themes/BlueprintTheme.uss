.theme-dark .free-play-size-badge {
    background-color: rgba(12, 53, 85, 0.94);
    border-color: rgb(91, 188, 210);
    -unity-text-outline-width: 0;
}

.theme-dark .free-play-pack-progress-track,
.theme-dark .free-play-size-progress-track {
    background-color: rgb(15, 63, 94);
    border-color: rgb(71, 147, 175);
}

.theme-dark .free-play-pack-progress-fill,
.theme-dark .free-play-size-progress-fill {
