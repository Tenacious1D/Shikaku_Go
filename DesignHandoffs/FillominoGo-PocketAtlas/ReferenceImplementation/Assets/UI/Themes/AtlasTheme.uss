/* Pocket Atlas shared visual language. Loaded after the legacy screen sheets. */
.screen-root,
.gameplay-background {
    background-color: rgb(244, 238, 220);
    background-image: url("project://database/Assets/Art/UI/Backgrounds/shikaku_warm_stone_paper_seamless.png");
    -unity-background-scale-mode: scale-and-crop;
}

.atlas-eyebrow {
    margin-bottom: 8px;
    color: rgb(126, 112, 92);
    font-size: 20px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.brand-section {
    height: 405px;
}

.brand-mark-scatter {
    width: 470px;
    height: 142px;
    margin-bottom: 0;
}

.brand-logo-tile {
    border-radius: 8px;
    border-bottom-width: 5px;
}

.scatter-blank { left: 22px; top: 68px; width: 112px; height: 62px; rotate: 0deg; }
.scatter-one { left: 22px; top: 18px; width: 112px; height: 50px; rotate: 0deg; }
.scatter-two { left: 134px; top: 18px; width: 72px; height: 112px; rotate: 0deg; }
.scatter-three { left: 206px; top: 18px; width: 118px; height: 62px; rotate: 0deg; }
.scatter-four { left: 206px; top: 80px; width: 118px; height: 50px; rotate: 0deg; }
.scatter-five { left: 324px; top: 18px; width: 124px; height: 112px; rotate: 0deg; }

.brand-title-row {
    height: 116px;
}

.brand-title {
    font-size: 96px;
    -unity-text-outline-width: 1px;
}

.tagline-row {
    height: 54px;
}

.tagline {
    font-size: 21px;
    letter-spacing: 2px;
}

.primary-actions {
    flex-grow: 1;
    width: 100%;
    max-width: 820px;
    justify-content: center;
}

.main-menu-button {
    min-height: 142px;
    margin-bottom: 18px;
    background-color: rgba(249, 244, 228, 0.98);
    border-color: rgb(176, 164, 137);
    border-bottom-width: 7px;
    border-radius: 18px;
}

.main-menu-button:hover {
    background-color: rgb(252, 247, 233);
}

.menu-button-inner {
    padding-right: 24px;
    padding-left: 24px;
}

.menu-button-copy {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.menu-button-label {
    font-size: 43px;
    -unity-text-align: middle-left;
}

.menu-button-note {
    margin-top: 2px;
    color: rgb(126, 112, 92);
    font-size: 20px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.menu-button-divider {
    background-color: rgba(126, 112, 92, 0.34);
}

.adventure-button { border-left-color: rgb(84, 142, 83); border-left-width: 10px; }
.free-play-button { border-left-color: rgb(68, 137, 164); border-left-width: 10px; }
.time-trial-button { border-left-color: rgb(190, 92, 67); border-left-width: 10px; }
.daily-button { border-left-color: rgb(208, 137, 20); border-left-width: 10px; }

.secondary-menu-button,
.daily-square-button,
.settings-back-button,
.shop-back-button,
.time-trial-back-button,
.free-play-back-button,
.adventure-back-button,
.gameplay-square-button {
    background-color: rgba(247, 242, 225, 0.98);
    border-color: rgb(176, 164, 137);
    border-bottom-width: 6px;
    border-radius: 15px;
}

.atlas-tablet-layout .primary-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.atlas-tablet-layout .main-menu-button {
    width: 48.5%;
    margin-right: 0;
    margin-left: 0;
}

/* Shared field-guide pages */
.daily-title,
.settings-title,
.shop-title,
.time-trial-title-dark,
.time-trial-title-blue,
.free-play-title-dark,
.free-play-title-green,
.adventure-title {
    font-size: 76px;
    -unity-text-outline-width: 1px;
}

.daily-calendar-card,
.settings-section-card,
.shop-pack-card,
.time-trial-mode-button,
.free-play-pack-button,
.free-play-size-button,
.free-play-level-grid-panel,
.adventure-chapter-button,
.adventure-level-grid-panel,
.gameplay-status-card,
.gameplay-modal-card,
.daily-modal-card,
.settings-ad-report-card,
.analytics-modal-card,
.privacy-welcome-card {
    background-color: rgba(249, 244, 228, 0.97);
    border-color: rgb(184, 173, 147);
    border-bottom-width: 6px;
    border-radius: 18px;
}

.settings-section-card {
    border-left-width: 6px;
    border-left-color: rgb(84, 142, 83);
}

.settings-section-heading,
.shop-balance-caption,
.gameplay-stat-caption {
    color: rgb(112, 98, 78);
    letter-spacing: 2px;
}

.settings-section-accent {
    background-color: rgb(208, 137, 20);
}

.settings-link-button,
.settings-control-row {
    border-bottom-color: rgba(145, 134, 113, 0.28);
}

.adventure-map-root {
    padding: 28px;
    background-color: rgba(224, 233, 208, 0.45);
    border-width: 2px;
    border-color: rgba(84, 142, 83, 0.35);
    border-radius: 22px;
}

.adventure-route-dash,
.adventure-route-dash-active {
    background-color: rgb(190, 92, 67);
}

.adventure-chapter-current,
.free-play-level-next,
.adventure-level-next,
.daily-day-today {
    border-color: rgb(208, 137, 20);
}

.adventure-chapter-complete,
.free-play-level-completed,
.adventure-level-completed,
.daily-day-completed {
    background-color: rgb(218, 229, 199);
    border-color: rgb(84, 142, 83);
}

.free-play-pack-emblem,
.free-play-size-badge,
.time-trial-board-badge,
.shop-pack-icon-shell,
.shop-bundle-icon-shell {
    background-color: rgb(228, 218, 190);
    border-color: rgb(166, 150, 118);
}

.daily-calendar-card {
    border-top-color: rgb(208, 137, 20);
    border-top-width: 8px;
}

.daily-complete-mark,
.adventure-level-checkmark,
.free-play-level-checkmark {
    -unity-background-image-tint-color: rgb(84, 142, 83);
}

.time-trial-sprint { border-left-width: 8px; border-left-color: rgb(84, 142, 83); }
.time-trial-quick { border-left-width: 8px; border-left-color: rgb(68, 137, 164); }
.time-trial-classic { border-left-width: 8px; border-left-color: rgb(208, 137, 20); }
.time-trial-expert { border-left-width: 8px; border-left-color: rgb(190, 92, 67); }

.shop-bundle-card {
    border-top-width: 8px;
    border-top-color: rgb(208, 137, 20);
}

.shop-best-value-badge {
    background-color: rgb(208, 137, 20);
}

/* Gameplay atlas */
.gameplay-title {
    font-size: 50px;
    -unity-text-outline-width: 1px;
}

.gameplay-subtitle {
    color: rgb(176, 111, 17);
    font-size: 27px;
}

.gameplay-title-ornament {
    margin-bottom: 3px;
}

.gameplay-ornament-diamond {
    background-color: rgb(190, 92, 67);
}

.gameplay-status-card {
    height: 94px;
    background-color: rgba(249, 244, 228, 0.94);
}

.gameplay-action-button {
    background-color: rgba(249, 244, 228, 0.98);
    border-color: rgb(176, 164, 137);
    border-bottom-width: 7px;
    border-radius: 18px;
}

.gameplay-hint-button {
    border-top-color: rgb(208, 137, 20);
}

.gameplay-reset-button {
    border-top-color: rgb(190, 92, 67);
}

.gameplay-not-quite-warning {
    flex-direction: row;
    align-items: center;
    background-color: rgba(249, 244, 228, 0.98);
    border-color: rgb(190, 92, 67);
    border-left-width: 7px;
}

.gameplay-tutorial-card {
    background-color: rgba(249, 244, 228, 0.99);
    border-color: rgb(176, 164, 137);
    border-top-width: 7px;
    border-top-color: rgb(208, 137, 20);
}

.gameplay-tutorial-guide-tile {
    background-color: rgb(208, 137, 20);
    border-color: rgb(151, 93, 12);
    border-radius: 9px;
}

.gameplay-tutorial-dot-active {
    background-color: rgb(190, 92, 67);
}

.gameplay-solved-card {
    border-top-width: 9px;
    border-top-color: rgb(84, 142, 83);
}

.gameplay-solved-check {
    color: rgb(84, 142, 83);
}

.gameplay-primary-button,
.daily-play-button,
.adventure-continue-button,
.free-play-continue-button,
.privacy-welcome-continue-button,
.analytics-primary-button {
    background-color: rgb(62, 119, 84);
    border-color: rgb(39, 85, 59);
}

.gameplay-danger-button,
.analytics-danger-button,
.settings-danger-button {
    background-color: rgb(177, 70, 61);
    border-color: rgb(128, 45, 40);
}

/* Pip sprite sheet slices */
.pip {
    flex-shrink: 0;
    width: 148px;
    height: 148px;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
}

.pip-small {
    width: 92px;
    height: 92px;
}

.pip-welcome {
    background-image: url("project://database/Assets/Art/UI/Atlas/Pip/pip-sprite-sheet.png?fileID=701000001&guid=8a71d436b8e241bf9c5e4fe937a2d610&type=3#pip_welcome");
}

.pip-teach {
    background-image: url("project://database/Assets/Art/UI/Atlas/Pip/pip-sprite-sheet.png?fileID=701000002&guid=8a71d436b8e241bf9c5e4fe937a2d610&type=3#pip_teach");
}

.pip-inspect {
    background-image: url("project://database/Assets/Art/UI/Atlas/Pip/pip-sprite-sheet.png?fileID=701000003&guid=8a71d436b8e241bf9c5e4fe937a2d610&type=3#pip_inspect");
}

.pip-hint {
    background-image: url("project://database/Assets/Art/UI/Atlas/Pip/pip-sprite-sheet.png?fileID=701000004&guid=8a71d436b8e241bf9c5e4fe937a2d610&type=3#pip_hint");
}

.pip-celebrate {
    background-image: url("project://database/Assets/Art/UI/Atlas/Pip/pip-sprite-sheet.png?fileID=701000005&guid=8a71d436b8e241bf9c5e4fe937a2d610&type=3#pip_celebrate");
}

.pip-concerned {
    background-image: url("project://database/Assets/Art/UI/Atlas/Pip/pip-sprite-sheet.png?fileID=701000006&guid=8a71d436b8e241bf9c5e4fe937a2d610&type=3#pip_concerned");
}

.gameplay-tutorial-heading .pip {
    margin-right: 10px;
}

.gameplay-not-quite-warning .pip {
    margin-right: 12px;
}

.theme-dark.screen-root,
.theme-dark .screen-root,
.theme-dark .gameplay-background,
.gameplay-background.theme-dark {
    background-color: rgb(47, 44, 39);
    background-image: url("project://database/Assets/Art/UI/Backgrounds/shikaku_dark_paper_seamless.png");
}

.theme-dark .main-menu-button,
.theme-dark .secondary-menu-button,
.theme-dark .daily-calendar-card,
.theme-dark .settings-section-card,
.theme-dark .shop-pack-card,
.theme-dark .time-trial-mode-button,
.theme-dark .free-play-pack-button,
.theme-dark .free-play-size-button,
.theme-dark .free-play-level-grid-panel,
.theme-dark .adventure-chapter-button,
.theme-dark .adventure-level-grid-panel,
.theme-dark .gameplay-status-card,
.theme-dark .gameplay-action-button,
.theme-dark .gameplay-modal-card,
.theme-dark .daily-modal-card,
.theme-dark .settings-ad-report-card,
.theme-dark .analytics-modal-card,
.theme-dark .privacy-welcome-card,
.theme-dark .gameplay-not-quite-warning,
.theme-dark .gameplay-tutorial-card {
    background-color: rgba(58, 54, 47, 0.98);
    border-color: rgb(104, 94, 78);
}

.theme-dark .menu-button-note,
.theme-dark .atlas-eyebrow,
.theme-dark .settings-section-heading,
.theme-dark .shop-balance-caption,
.theme-dark .gameplay-stat-caption {
    color: rgb(198, 187, 164);
}

.theme-dark .adventure-map-root {
    background-color: rgba(55, 69, 55, 0.55);
    border-color: rgba(129, 157, 112, 0.5);
}

.theme-dark .adventure-chapter-complete,
.theme-dark .free-play-level-completed,
.theme-dark .adventure-level-completed,
.theme-dark .daily-day-completed {
    background-color: rgb(53, 78, 58);
    border-color: rgb(112, 157, 104);
}